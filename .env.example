# --- Required ---
DATABASE_URL="mysql://USER:PASSWORD@localhost:3307/moneytalk_db"
JWT_ACCESS_SECRET="cambia-esto-por-un-secreto-largo"
JWT_REFRESH_SECRET="cambia-esto-por-otro-secreto-largo"
OPENAI_API_KEY="sk-..."

# --- Server ---
PORT=3000
NODE_ENV=development
# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGIN="http://localhost:5173"
# Timezone for cron schedules and default for users without one
APP_TIMEZONE="America/La_Paz"

# --- Sessions (optional) ---
# JWT_ACCESS_EXPIRES_IN=30m
# REFRESH_TOKEN_TTL_DAYS=30

# --- AI (optional) ---
# OPENAI_MODEL=gpt-4o-mini

# --- Google sign-in (optional; without it the Google button fails with 503) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Push notifications (optional; generate with `npx web-push generate-vapid-keys`) ---
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:soporte@moneytalk.app"

# --- Jobs (optional) ---
# ENABLE_CRON=true            # recurring payments, daily at 00:01
# ENABLE_NOTIFICATIONS=true   # push reminders
# CRON_TEST_MODE=false        # true = run jobs every few minutes for testing
