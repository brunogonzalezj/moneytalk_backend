{
  "name": "moneytalk_backend",
  "version": "1.0.0",
  "description": "Backend API for MoneyTalk application",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "prisma migrate dev --create-only",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "prisma db seed",
    "test": "jest",
    "test:cov": "jest --coverage",
    "postinstall": "prisma generate",
    "lint": "eslint ."
  },
  "keywords": [
    "finance",
    "transactions",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "csv-stringify": "^6.9.0",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "express-validator": "^7.3.2",
    "google-auth-library": "^11.3.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "openai": "^7.52.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
